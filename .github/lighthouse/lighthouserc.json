{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/pricing",
        "http://localhost:3000/demo",
        "http://localhost:3000/checks",
        "http://localhost:3000/checks/hsts-missing",
        "http://localhost:3000/changelog",
        "http://localhost:3000/docs",
        "http://localhost:3000/docs/cli",
        "http://localhost:3000/security",
        "http://localhost:3000/signup",
        "http://localhost:3000/login",
        "http://localhost:3000/legal/privacy"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3000/(pricing|demo|security|changelog|legal/privacy)?$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:performance": ["warn", { "minScore": 0.7 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/docs(/cli)?$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:performance": ["warn", { "minScore": 0.7 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/checks(/hsts-missing)?$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:performance": ["warn", { "minScore": 0.7 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/(signup|login)$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:performance": ["warn", { "minScore": 0.7 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
