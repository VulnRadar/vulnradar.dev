# Common ignores
node_modules/
.next/
.env*.local
.DS_Store
.env
.opencode
graphify-out

# Pre-migration database backups (scripts/_lib/_lib.backup.mjs) -- real
# customer data, never commit.
/databases/

# Agent instructions - never commit; per-developer files
AGENTS.md
CLAUDE.md

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# TypeScript build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Coverage
coverage/
.nyc_output/

# Local artifacts
out/
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependency directories
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
nscripts/storage/

# FP audit temporary scan storage
scripts/storage/

# Bulk-scan QA tool output: per-host findings JSON, not source, not for
# git history (may contain pattern-matched strings that look like secrets
# even when they're false positives).
engine/data/host-json/

# Note: the extension/ directory has its OWN .gitignore that handles
# its own build outputs (dist-*/, node_modules/, *.tsbuildinfo).
# The main .gitignore must NOT add extension/* here or it would
# ignore ALL of the extension source, which is wrong.
