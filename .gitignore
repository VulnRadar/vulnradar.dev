.idea/
.vscode/
*.swp
*.swo
*~

# TypeScript build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Coverage
coverage/
.nyc_output/

# Local artifacts
out/
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependency directories
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# FP audit temporary scan storage
scripts/storage/

# Bulk-scan QA tool output: per-host findings JSON, not source, not for
# git history (may contain pattern-matched strings that look like secrets
# even when they're false positives).
engine/data/host-json/

# Note: the extension/ directory has its OWN .gitignore that handles
# its own build outputs (dist-*/, node_modules/, *.tsbuildinfo).
# The main .gitignore must NOT add extension/* here or it would
# ignore ALL of the extension source, which is wrong.

# Marketing / Remotion video project. The WHOLE directory stays local: it
# carries node_modules, rendered video, downloaded audio and API keys, none of
# which belong in the product repo.
marketing/


# Local source archives, never committed (a 25MB .rar was staged once).
*.rar
*.zip

certificates

# --- hardening, added after a git-history audit ---
# Two real API_KEY_ENCRYPTION_KEY values and two Turnstile secrets reached
# public history through a committed .env.example and a docs page. Both were
# rotated, but the rules below are what stop the next one, since the only
# reliable remedy after the fact is rotation: commits stay fetchable from
# GitHub's pull refs even after a history rewrite.

# Every dotenv variant at any depth, not just .env and .env*.local. This
# missed .env.production, .env.staging and app/.env.local.
.env.*
!.env.example

# Key material and certificates. certificates/localhost-key.pem is a real
# private key sitting untracked in this repo right now.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa
id_ed25519

# Database dumps. Deliberately NOT a blanket *.sql, which would shadow the
# tracked scripts/*.sql migrations.
*.sql.gz
*.dump
*.bak

# Agent and platform working directories. .claude/worktrees/ is a full second
# checkout (~18 MB) and was only ever saved by a local .git/info/exclude,
# which is not shared, so any fresh clone would stage it.
.claude/
.vercel/

# Generated audit artefacts. The AUDIT-*/ records stay tracked because the
# audit:list / audit:show / audit:close scripts read them; these three are
# one-off output that was committed by accident.
#
# report.html alone carried four HIGH js/xss-through-dom code-scanning alerts:
# it builds its own DOM from finding text, and finding text is scraped from
# scanned third-party pages. Nothing renders it in the product, so the alerts
# were pure noise from a file that did not belong in git.
audits/report.html
audits/merged-findings.json
audits/email-previews/
