audit-level=high
fund=false
update-notifier=false

# Refuse to install under a Node version outside package.json's `engines`
# range (">=22.0.0 <23.0.0"). Without this, npm downgrades an engines
# mismatch to a warning that scrolls past in the install output, and the
# repo has a concrete reason to care: the Dockerfile builds and runs on an
# exact Node pin (node:22.11.0-alpine) and every CI job pins the same patch,
# so an install resolved under a different major is a tree nobody ships.
# This file is COPYied into the Docker builder, so the container install is
# held to the same range.
engine-strict=true
