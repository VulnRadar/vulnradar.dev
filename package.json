{
  "name": "vulnradar",
  "version": "3.5.0",
  "description": "Professional open-source web vulnerability scanner",
  "license": "GPL-3.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/compile-docs-knowledge.mjs && node scripts/compile-changelog-knowledge.mjs && node scripts/compile-checks-knowledge.mjs && node scripts/compile-legal-knowledge.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/compile-docs-knowledge.mjs && node scripts/compile-changelog-knowledge.mjs && node scripts/compile-checks-knowledge.mjs && node scripts/compile-legal-knowledge.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:compile": "node scripts/compile-docs-knowledge.mjs",
    "changelog:compile": "node scripts/compile-changelog-knowledge.mjs",
    "checks:compile": "node scripts/compile-checks-knowledge.mjs",
    "legal:compile": "node scripts/compile-legal-knowledge.mjs",
    "build:knowledge": "node scripts/compile-docs-knowledge.mjs && node scripts/compile-changelog-knowledge.mjs && node scripts/compile-checks-knowledge.mjs && node scripts/compile-legal-knowledge.mjs",
    "db:migrate": "node scripts/migrate/migrate.mjs",
    "db:migrate:dry-run": "node scripts/migrate/migrate.mjs --dry-run",
    "db:create": "node scripts/create-fresh-db/create-fresh-db.mjs",
    "db:create:dry-run": "node scripts/create-fresh-db/create-fresh-db.mjs --dry-run",
    "db:diagnose": "node scripts/db-diagnose.mjs",
    "db:diagnose-2fa": "node scripts/db-diagnose-2fa.mjs",
    "db:repair": "node scripts/db-repair.mjs",
    "db:repair-2fa": "node scripts/db-repair-2fa.mjs",
    "db:repair-sequences": "node scripts/db-repair-sequences.mjs",
    "db:migrate-avatars": "node scripts/migrate-avatars-to-files.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "audit:v2-tables": "node scripts/_lib/audit-v2-tables.mjs",
    "audit:new": "node scripts/audit/new.mjs",
    "audit:add-finding": "node scripts/audit/add-finding.mjs",
    "audit:list": "node scripts/audit/list.mjs",
    "audit:show": "node scripts/audit/show.mjs",
    "audit:close": "node scripts/audit/close.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/openai": "^4.0.41",
    "@hookform/resolvers": "5.8.0",
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@stripe/react-stripe-js": "6.8.1",
    "@stripe/stripe-js": "9.13.0",
    "@vitest/coverage-v8": "4.1.10",
    "ai": "^7.0.65",
    "autoprefixer": "10.5.4",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "jose": "^6.2.8",
    "jsonwebtoken": "9.0.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "^1.31.0",
    "next": "15.5.23",
    "next-themes": "0.4.6",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-icons": "5.7.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "stripe": "22.5.0",
    "swr": "2.5.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "tslib": "2.8.1",
    "vaul": "1.1.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "^0.35.0",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript-eslint/visitor-keys": "8.66.0",
    "@typescript-eslint/types": "8.66.0",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "core-js": true
  }
}
