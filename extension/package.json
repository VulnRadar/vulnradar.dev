{
  "name": "vulnradar-extension",
  "version": "0.2.0",
  "description": "One-click vulnerability scanning for any website you visit. Powered by VulnRadar.",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "node scripts/build.mjs && node scripts/package.mjs && node scripts/package-source.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "icons": "node scripts/generate-icons.mjs",
    "package": "node scripts/package.mjs",
    "package:source": "node scripts/package-source.mjs",
    "clean": "node -e \"import('node:fs').then(fs => fs.promises.rm('dist-chrome',{recursive:true,force:true}).then(()=>fs.promises.rm('dist-firefox',{recursive:true,force:true})))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,html,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json,md}\"",
    "tokens": "node scripts/gen-tokens.mjs"
  },
  "dependencies": {
    "lit-html": "^3.2.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^22.10.5",
    "@types/webextension-polyfill": "^0.12.5",
    "archiver": "^8.0.0",
    "prettier": "3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
