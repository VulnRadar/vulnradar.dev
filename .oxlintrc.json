{
  // Oxlint runs before ESLint (`npm run lint`) and owns every rule it has.
  // eslint.config.mjs switches those rules off on its side through
  // eslint-plugin-oxlint, reading this file, so no rule runs twice. ESLint
  // keeps what Oxlint cannot do yet: the type-aware promise rules on the auth
  // and billing surface, the React Compiler readiness rules, and the
  // no-restricted-syntax selector for hardcoded API paths.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "jsx-a11y",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "out/**",
    "build/**",
    "dist/**",
    "coverage/**",
    "public/**",
    "scripts/create-fresh-db/schemas/**",
    "scripts/storage/**",
    "marketing/**",
    // Generated by Next on every build.
    "next-env.d.ts"
  ],
  "rules": {
    // Same options as the ESLint rule it replaces: props are dictated by the
    // parent interface, and a caught error may go unused.
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],

    // Warnings in ESLint today, kept as warnings so the move changes nothing.
    "react-hooks/exhaustive-deps": "warn",
    "react/set-state-in-effect": "warn",
    "nextjs/no-img-element": "warn",
    // Off in ESLint too. Sixteen plain anchors to app routes remain; each is
    // a full page load where Link would navigate in place, which costs a
    // reload, not correctness. The error boundary's anchor wants the reload.
    "nextjs/no-html-link-for-pages": "off",

    // Every autoFocus in the app is on a field the visitor has just asked
    // for: the first input of a dialog they opened, an inline editor they
    // clicked into, or the one field of a one-field page (a sign-in code, a
    // password reset). Moving focus there is what the dialog pattern asks
    // for, not the unexpected focus jump this rule exists to prevent.
    "jsx-a11y/no-autofocus": "off",
    // Suggests <output> for every role="status" and <dialog> for every
    // role="dialog". A loading placeholder is not the result of a
    // calculation, and the dialogs are Radix primitives.
    "jsx-a11y/prefer-tag-over-role": "off",

    // Text three levels down (a button holding a div holding a span) is still
    // the control's name, and the Radix Checkbox is a real checkbox.
    "jsx-a11y/label-has-associated-control": [
      "error",
      { "depth": 4, "controlComponents": ["Checkbox"] }
    ],
    "jsx-a11y/control-has-associated-label": ["error", { "depth": 4 }],

    // Vitest's expect takes an optional second argument, a failure message.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // Style, not correctness: typing every vi.fn(), and a message on every
    // toThrow.
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    // The table-driven harnesses branch on the fixture's expected outcome,
    // and several suites assert through helpers (assertOk, a guarded throw)
    // rather than expect.
    "vitest/no-conditional-expect": "off",
    "vitest/no-conditional-tests": "off",
    "vitest/expect-expect": "off",
    // Titles built from a function's name or a table row.
    "vitest/valid-title": "off"
  }
}
